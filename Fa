<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>もしもの家族ナビ｜高齢者と家族のための入院・退院・介護ガイド</title>
  <meta name="description" content="高齢の親や家族に万が一が起きた時、入院・退院・介護・お金・相談先を看護師目線で整理する家族向けナビサイト。">
  <style>
    :root{
      --bg:#f8f4ec;
      --paper:#fffdf8;
      --ink:#1f2933;
      --muted:#667085;
      --line:#e7ddcd;
      --accent:#8a5a1f;
      --accent2:#c09349;
      --dark:#17324d;
      --safe:#2f6f4e;
      --warn:#9a5b00;
      --danger:#a43f3f;
      --shadow:0 18px 45px rgba(45,33,18,.12);
      --radius:22px;
      --font: "Hiragino Sans", "Yu Gothic", "YuGothic", "Noto Sans JP", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      font-size:16px;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:var(--font);
      color:var(--ink);
      background:
        radial-gradient(circle at top left, rgba(192,147,73,.22), transparent 28rem),
        linear-gradient(180deg, #fbf8f1 0%, var(--bg) 42%, #fffaf0 100%);
      line-height:1.8;
    }
    a{color:var(--accent);font-weight:700}
    ruby rt{font-size:.62em;color:var(--muted)}
    .wrap{width:min(1120px,92vw);margin:auto}
    header{
      position:sticky;top:0;z-index:20;
      backdrop-filter:blur(14px);
      background:rgba(255,253,248,.86);
      border-bottom:1px solid rgba(231,221,205,.85);
    }
    .nav{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px 0}
    .brand{display:flex;align-items:center;gap:10px;font-weight:900;letter-spacing:.03em}
    .mark{width:38px;height:38px;border-radius:14px;background:linear-gradient(135deg,var(--dark),#315c7c);display:grid;place-items:center;color:#fff;box-shadow:var(--shadow)}
    .navlinks{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}
    .navlinks a,.smallbtn{
      text-decoration:none;color:var(--ink);border:1px solid var(--line);
      padding:8px 12px;border-radius:999px;background:#fff;font-size:.92rem
    }
    .smallbtn{cursor:pointer;font-weight:700}
    .hero{padding:58px 0 26px}
    .hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:28px;align-items:center}
    .kicker{display:inline-flex;gap:8px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.72);font-weight:800;color:var(--accent)}
    h1{font-size:clamp(2rem,5vw,4.2rem);line-height:1.12;margin:18px 0 16px;letter-spacing:-.03em}
    h2{font-size:clamp(1.45rem,3vw,2.45rem);line-height:1.25;margin:0 0 14px}
    h3{font-size:1.25rem;line-height:1.35;margin:0 0 10px}
    .lead{font-size:1.08rem;color:#3f4b56;max-width:62ch}
    .hero-card{
      background:linear-gradient(180deg,#fffdf8,#f9efe0);
      border:1px solid var(--line);border-radius:28px;padding:24px;box-shadow:var(--shadow)
    }
    .hero-card h3{font-size:1.45rem}
    .status-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:14px}
    .status-btn{
      border:1px solid var(--line);background:#fff;border-radius:17px;padding:14px 12px;text-align:left;
      font:inherit;font-weight:800;color:var(--ink);cursor:pointer;transition:.18s ease;
    }
    .status-btn:hover{transform:translateY(-2px);border-color:var(--accent2);box-shadow:0 12px 26px rgba(138,90,31,.12)}
    .cta-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:22px}
    .btn{
      display:inline-flex;align-items:center;justify-content:center;gap:8px;
      border:none;border-radius:16px;padding:13px 18px;font-weight:900;text-decoration:none;cursor:pointer;
      background:var(--dark);color:#fff;box-shadow:0 14px 28px rgba(23,50,77,.18)
    }
    .btn.gold{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff}
    .btn.light{background:#fff;color:var(--ink);border:1px solid var(--line);box-shadow:none}
    .trust{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:26px 0 4px}
    .trust div{background:rgba(255,255,255,.72);border:1px solid var(--line);padding:14px;border-radius:18px;font-weight:800}
    section{padding:48px 0}
    .section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:18px}
    .section-head p{color:var(--muted);max-width:58ch;margin:0}
    .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .card{
      background:rgba(255,253,248,.92);border:1px solid var(--line);border-radius:var(--radius);
      padding:20px;box-shadow:0 10px 32px rgba(45,33,18,.06)
    }
    .card.emph{border-color:rgba(192,147,73,.65);background:linear-gradient(180deg,#fffdf8,#fff5df)}
    .badge{display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;font-size:.78rem;font-weight:900;border:1px solid var(--line);background:#fff;color:var(--accent);margin-bottom:10px}
    .badge.free{color:var(--safe)}
    .badge.std{color:var(--accent)}
    .badge.pre{color:#7540a5}
    .compare{overflow:auto;border-radius:var(--radius);border:1px solid var(--line);background:#fff}
    table{width:100%;border-collapse:collapse;min-width:760px}
    th,td{padding:14px;border-bottom:1px solid var(--line);vertical-align:top;text-align:left}
    th{background:#fbf4e8;color:#2d3035}
    tr:last-child td{border-bottom:none}
    .win{font-weight:900;color:var(--safe)}
    .weak{color:var(--muted)}
    .scenario-panel{display:none;margin-top:16px}
    .scenario-panel.active{display:block}
    .step-list{display:grid;gap:10px;counter-reset:item}
    .step{
      position:relative;background:#fff;border:1px solid var(--line);border-radius:18px;padding:14px 16px 14px 48px
    }
    .step:before{
      counter-increment:item;content:counter(item);
      position:absolute;left:14px;top:16px;width:24px;height:24px;border-radius:50%;
      background:var(--dark);color:#fff;font-size:.82rem;display:grid;place-items:center;font-weight:900
    }
    .interactive{
      display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:start
    }
    .question{
      background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:18px;margin-bottom:12px
    }
    .q-top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
    .why{
      flex:0 0 auto;border:none;border-radius:999px;background:#f2e6d5;color:var(--accent);font-weight:900;
      padding:6px 10px;cursor:pointer;font-size:.85rem
    }
    .why-text{display:none;margin-top:10px;padding:12px;border-radius:16px;background:#fbf5ea;color:#554535}
    .why-text.show{display:block}
    textarea,input[type="text"]{
      width:100%;border:1px solid var(--line);border-radius:16px;padding:12px;font:inherit;background:#fffdf8;min-height:92px
    }
    input[type="text"]{min-height:auto}
    .example{margin-top:8px;display:flex;gap:8px;flex-wrap:wrap}
    .example button{border:1px solid var(--line);background:#fff;border-radius:999px;padding:6px 10px;cursor:pointer;color:var(--accent);font-weight:800}
    .checklist{display:grid;gap:8px}
    .check{
      display:flex;gap:10px;align-items:flex-start;background:#fff;border:1px solid var(--line);border-radius:15px;padding:10px 12px
    }
    .check input{width:20px;height:20px;margin-top:4px}

    .filter-box{background:rgba(255,253,248,.95);border:1px solid var(--line);border-radius:var(--radius);padding:18px;box-shadow:0 10px 32px rgba(45,33,18,.06)}
    .filter-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:12px 0}
    .filter-grid label{font-weight:900;font-size:.92rem;color:#39434d}
    select,.search-input{width:100%;border:1px solid var(--line);border-radius:15px;padding:11px 12px;font:inherit;background:#fffdf8;color:var(--ink)}
    .condition-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:12px}
    .condition{display:flex;gap:10px;align-items:flex-start;border:1px solid var(--line);background:#fff;border-radius:16px;padding:11px 12px;font-weight:800;cursor:pointer}
    .condition input{width:20px;height:20px;margin-top:4px;flex:0 0 auto}
    .recommend-box{background:#fdf3df;border:1px solid rgba(192,147,73,.55);border-radius:18px;padding:14px;margin-top:14px}
    .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
    .chip{border:1px solid rgba(138,90,31,.25);background:#fff;border-radius:999px;padding:6px 10px;font-weight:900;color:var(--accent);font-size:.86rem}
    .facility-results{display:grid;gap:12px;margin-top:14px}
    .facility-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:15px;box-shadow:0 8px 22px rgba(45,33,18,.05)}
    .facility-card h3{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .type-tag{display:inline-flex;border:1px solid var(--line);background:#fbf5ea;border-radius:999px;padding:4px 9px;font-size:.78rem;font-weight:900;color:#624620;margin:3px 4px 3px 0}
    .matched{color:var(--safe);font-weight:950}
    .save-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
    .save-btn,.memo-btn,.remove-saved-btn,.clear-saved-btn{
      border:1px solid var(--line);background:#fff;border-radius:999px;padding:8px 12px;cursor:pointer;font-weight:900;color:var(--ink)
    }
    .save-btn.saved{background:#f7ecd5;color:#6b4211;border-color:rgba(192,147,73,.55)}
    .memo-btn{background:#fffdf8;color:var(--accent)}
    .remove-saved-btn{background:#fff;color:var(--danger)}
    .clear-saved-btn{background:#fff;color:var(--danger)}
    .saved-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:12px}
    .saved-count{font-weight:900;color:var(--accent)}
    .saved-empty{background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px;color:var(--muted)}
    .saved-note{width:100%;min-height:74px;margin-top:10px;border:1px solid var(--line);border-radius:16px;padding:10px;font:inherit;background:#fffdf8}
    .facility-table{overflow:auto;border-radius:var(--radius);border:1px solid var(--line);background:#fff}
    .facility-table table{min-width:980px}
    .source-note{font-size:.9rem;color:var(--muted);margin-top:10px}

    .coordination-notice{
      position:relative;border:1px solid rgba(192,147,73,.7);background:linear-gradient(135deg,#fff8e8,#fffdf8);
      border-radius:20px;padding:16px;margin:16px 0;box-shadow:0 12px 30px rgba(45,33,18,.08)
    }
    .coordination-notice strong{display:block;color:#6b4211;font-size:1.04rem;margin-bottom:5px}
    .coordination-notice p{margin:6px 0;color:var(--ink)}
    .coordination-modal{
      position:fixed;inset:auto 18px 18px auto;max-width:430px;z-index:9999;background:#fffdf8;border:1px solid rgba(192,147,73,.75);
      border-radius:22px;padding:18px 52px 18px 18px;box-shadow:0 24px 70px rgba(16,40,62,.25);display:none
    }
    .coordination-modal.show{display:block}
    .coordination-modal strong{display:block;color:#6b4211;font-size:1.05rem;margin-bottom:6px}
    .coordination-modal p{margin:6px 0;color:var(--ink)}
    @media(max-width:640px){.coordination-modal{left:14px;right:14px;bottom:14px;max-width:none}}

    .external-links{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
    .external-link{
      display:inline-flex;align-items:center;justify-content:center;gap:6px;
      border:1px solid var(--line);background:#fffdf8;color:var(--ink);text-decoration:none;
      border-radius:999px;padding:7px 11px;font-size:.86rem;font-weight:900
    }
    .external-link.primary{background:#10283e;color:#fff;border-color:#10283e}
    .external-link.review{background:#fff3dc;color:#6b4211;border-color:rgba(192,147,73,.45)}
    .role-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .role-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:18px;box-shadow:0 10px 32px rgba(45,33,18,.06)}
    .role-card h3{margin-bottom:8px}
    .role-card ul{padding-left:1.2em;margin:8px 0}
    .role-card .ask{background:#fbf5ea;border:1px solid var(--line);border-radius:15px;padding:10px;margin-top:10px;font-size:.94rem}
    .source-split{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:12px}
    .source-split div{background:#fff;border:1px solid var(--line);border-radius:16px;padding:12px}

    .paywall{
      border:1px dashed rgba(138,90,31,.55);background:#fff8ea;border-radius:var(--radius);padding:20px;margin-top:16px
    }
    .pricing{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .price-card{position:relative;overflow:hidden}
    .price{font-size:2.1rem;font-weight:950;letter-spacing:-.04em}
    .price small{font-size:1rem;color:var(--muted)}
    .feature{display:flex;gap:8px;margin:8px 0}
    .feature:before{content:"✓";font-weight:950;color:var(--safe)}
    .feature.no:before{content:"—";color:var(--muted)}
    .notice{
      border-left:5px solid var(--danger);background:#fff;border-radius:18px;padding:16px 18px;margin-top:18px
    }
    .notice strong{color:var(--danger)}
    .footer{
      background:#10283e;color:#f7efe2;padding:38px 0;margin-top:40px
    }
    .footer a{color:#ffdf9b}
    .two{display:grid;grid-template-columns:1fr 1fr;gap:16px}
    .refs{font-size:.9rem;color:#d5deea}
    .bigtext{font-size:1.16rem}
    .high-contrast{--bg:#fff;--paper:#fff;--ink:#111;--muted:#333;--line:#111;--accent:#000;--accent2:#000;--dark:#000}
    .font-large{font-size:18px}
    .font-xlarge{font-size:20px}

    .emergency-ribbon{
      background:#fff5f5;border-bottom:1px solid rgba(164,63,63,.24);color:#5b1e1e
    }
    .emergency-ribbon .wrap{display:flex;gap:12px;align-items:center;justify-content:space-between;padding:10px 0;font-weight:850}
    .emergency-ribbon strong{color:var(--danger)}
    .emergency-ribbon a{color:var(--danger)}
    .visual-hero{position:relative;min-height:260px;display:grid;place-items:center;background:linear-gradient(180deg,#fffdf8,#eef7f3);border:1px solid var(--line);border-radius:30px;box-shadow:var(--shadow);overflow:hidden}
    .visual-hero:before{content:"";position:absolute;inset:auto -50px -70px auto;width:220px;height:220px;background:rgba(47,111,78,.11);border-radius:50%}
    .visual-hero svg{width:min(92%,420px);height:auto;position:relative;z-index:1}
    .illu-card{display:flex;gap:14px;align-items:flex-start;background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:18px;box-shadow:0 10px 28px rgba(45,33,18,.06)}
    .illu-icon{flex:0 0 74px;width:74px;height:74px;border-radius:22px;background:linear-gradient(180deg,#f1faf6,#fff8ea);display:grid;place-items:center;border:1px solid var(--line)}
    .illu-icon svg{width:58px;height:58px}
    .use-steps{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;counter-reset:usesteps}
    .use-step{position:relative;background:#fff;border:1px solid var(--line);border-radius:20px;padding:16px;min-height:154px}
    .use-step:before{counter-increment:usesteps;content:counter(usesteps);width:30px;height:30px;border-radius:999px;background:#10283e;color:#fff;display:grid;place-items:center;font-weight:950;margin-bottom:10px}
    .quick-mode{display:grid;grid-template-columns:1fr 1fr;gap:16px}
    .mode-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:20px;box-shadow:0 10px 28px rgba(45,33,18,.06)}
    .mode-card ol{margin:.5em 0 0;padding-left:1.4em}
    .design-system{display:grid;grid-template-columns:1.05fr .95fr;gap:16px;align-items:stretch}
    .token-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:10px}
    .token{background:#fff;border:1px solid var(--line);border-radius:16px;padding:12px}
    .swatches{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
    .swatch{width:42px;height:42px;border-radius:14px;border:1px solid var(--line);box-shadow:inset 0 0 0 2px rgba(255,255,255,.45)}
    .swatch.dark{background:#17324d}.swatch.green{background:#2f6f4e}.swatch.gold{background:#c09349}.swatch.cream{background:#f8f4ec}.swatch.danger{background:#a43f3f}
    .faq-list{display:grid;gap:10px}
    details.faq{background:#fff;border:1px solid var(--line);border-radius:18px;padding:14px 16px;box-shadow:0 8px 22px rgba(45,33,18,.04)}
    details.faq summary{cursor:pointer;font-weight:950;color:#10283e}
    details.faq p{margin:10px 0 0;color:#3f4b56}
    .patient-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
    .mini-scale{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-top:8px}
    .scale-btn{border:1px solid var(--line);background:#fffdf8;border-radius:12px;padding:8px 6px;font-weight:900;font-size:.84rem;text-align:center}
    .summary-box{background:#f5fbf8;border:1px solid rgba(47,111,78,.25);border-radius:18px;padding:14px;margin-top:12px}
    .sticky-help{position:fixed;right:18px;bottom:18px;z-index:50;display:flex;flex-direction:column;gap:8px;align-items:flex-end}
    .sticky-help a{background:#10283e;color:#fff;text-decoration:none;border-radius:999px;padding:10px 14px;box-shadow:0 12px 32px rgba(16,40,62,.2);font-weight:900}
    .sticky-help a.light{background:#fff;color:#10283e;border:1px solid var(--line)}
    .print-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:20px}
    .print-card h3{display:flex;gap:10px;align-items:center}

    .share-panel{background:linear-gradient(180deg,#fffdf8,#f3faf6);border:1px solid rgba(47,111,78,.28);border-radius:var(--radius);padding:20px;box-shadow:0 10px 32px rgba(45,33,18,.06)}
    .share-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
    .share-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px}
    .share-url-box{width:100%;min-height:84px;border:1px solid var(--line);border-radius:16px;background:#fffdf8;padding:12px;font:inherit;color:#24313d;word-break:break-all;line-height:1.6}
    .share-status{margin-top:10px;padding:10px 12px;border-radius:14px;background:#f5fbf8;border:1px solid rgba(47,111,78,.25);color:#264b38;font-weight:800;display:none}
    .share-status.show{display:block}
    .share-status.warn{background:#fff8e8;border-color:rgba(154,91,0,.25);color:#6f4300}
    .share-import-banner{display:none;position:fixed;left:50%;bottom:22px;transform:translateX(-50%);z-index:80;background:#10283e;color:#fff;border-radius:22px;padding:14px 16px;box-shadow:0 18px 45px rgba(16,40,62,.24);max-width:min(720px,92vw)}
    .share-import-banner.show{display:block}
    .share-import-banner p{margin:0 0 8px;color:#fff}
    .share-import-banner .btn{box-shadow:none;padding:9px 12px;border-radius:12px;font-size:.92rem}
    .share-import-banner .btn.light{color:#10283e;background:#fff}
    .share-small{font-size:.92rem;color:var(--muted);margin-top:8px}

    @media(max-width:980px){.use-steps,.patient-grid,.design-system,.quick-mode,.share-grid{grid-template-columns:1fr}.sticky-help{display:none}}

    @media(max-width:860px){
      .hero-grid,.interactive,.two{grid-template-columns:1fr}
      .cards,.pricing,.trust,.filter-grid,.condition-grid,.role-grid,.source-split{grid-template-columns:1fr}
      .status-grid{grid-template-columns:1fr}
      .navlinks{display:none}
      section{padding:34px 0}
    }

    /* v9: スマホ閲覧を前提にした表示調整 */
    @media(max-width:640px){
      :root{font-size:15px;--radius:18px}
      body{line-height:1.75;overflow-x:hidden;background:linear-gradient(180deg,#fbf8f1 0%,#f8f4ec 60%,#fffaf0 100%)}
      .wrap{width:calc(100% - 28px)}
      .emergency-ribbon .wrap{display:block;padding:9px 0;font-size:.9rem}
      .emergency-ribbon a{display:inline-block;margin-top:6px}
      .nav{padding:9px 0}
      .brand{gap:8px;font-size:.95rem;line-height:1.25}
      .mark{width:34px;height:34px;border-radius:12px;flex:0 0 auto}
      .hero{padding:26px 0 12px}
      .hero-grid{gap:16px}
      .kicker{font-size:.84rem;line-height:1.4;border-radius:16px;align-items:flex-start}
      h1{font-size:2rem;line-height:1.18;margin:14px 0 12px;letter-spacing:-.02em}
      h2{font-size:1.45rem;line-height:1.32}
      h3{font-size:1.08rem;line-height:1.42}
      .lead{font-size:1rem;line-height:1.8}
      .hero-card{padding:16px;border-radius:22px}
      .hero-card h3{font-size:1.18rem}
      .visual-hero{min-height:205px;border-radius:22px;margin-top:8px}
      .visual-hero svg{width:96%}
      .status-grid{gap:8px}
      .status-btn{min-height:50px;padding:13px 12px;border-radius:15px;font-size:.98rem}
