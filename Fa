  function renderFacilities(){
    const pref=document.getElementById('prefSelect')?.value || '';
    const city=document.getElementById('citySelect')?.value || '';
    const q=(document.getElementById('facilitySearch')?.value || '').trim().toLowerCase();
    const selected=getSelectedConditions();
    const results=document.getElementById('facilityResults');
    if(!results) return;
    const filtered=facilities.filter(f=>{
      const tags=(f.tags||'').split(',').map(x=>x.trim());
      const hay=[f.name,f.category,f.types,f.features,f.notes,f.address].join(' ').toLowerCase();
      const condOk=!selected.length || selected.some(s=>tags.includes(s));
      return (!pref || f.prefecture===pref) && (!city || f.city===city) && (!q || hay.includes(q)) && condOk;
    });
    if(!filtered.length){
      results.innerHTML='<div class="facility-card"><strong>該当するサンプルデータがありません。</strong><p>都道府県・市町村を広げるか、facilities.csvに施設データを追加してください。実際の施設確認は公的検索システムや各施設への問い合わせが必要です。</p></div>';
      return;
    }
    results.innerHTML=filtered.map(f=>{
      const tagMatch=selected.some(s=>(f.tags||'').split(',').map(x=>x.trim()).includes(s));
      const types=(f.types||'').split(',').filter(Boolean).map(t=>`<span class="type-tag">${t.trim()}</span>`).join('');
      return `<article class="facility-card">
        <h3>${f.name} ${tagMatch ? '<span class="matched">状態に一致</span>' : ''}</h3>
        <div>${types}</div>
        <p><strong>地域：</strong>${f.prefecture}${f.city ? ' '+f.city : ''}　<strong>分類：</strong>${f.category||''}</p>
        <p><strong>特徴：</strong>${f.features||'未登録'}</p>
        <p><strong>確認メモ：</strong>${f.notes||'未登録'}</p>
        <p><strong>所在地：</strong>${f.address||'未登録'}　<strong>電話：</strong>${f.phone||'未登録'}</p>
        <div class="save-actions">
          <button class="save-btn" type="button" data-save-id="${facilityId(f)}">保存する</button>
          <button class="memo-btn" type="button" data-scroll-saved="${facilityId(f)}">保存一覧を見る</button>
        </div>
        ${externalLinks(f)}
        <p class="source-note"><strong>連絡前の確認：</strong>退院先として検討する場合は、家族から施設へ連絡する前に、病院の担当看護師・退院支援看護師・医療相談員へ一度声をかけてください。口コミは個人の感想を含みます。最終判断は、公式情報・見学・直接問い合わせ・担当者への相談で確認してください。</p>
      </article>`;
    }).join('');
    document.querySelectorAll('[data-save-id]').forEach(btn=>{
      btn.addEventListener('click',()=>toggleSaveFacilityById(btn.dataset.saveId));
    });
    document.querySelectorAll('[data-scroll-saved]').forEach(btn=>{
      btn.addEventListener('click',()=>document.getElementById('saved-facilities')?.scrollIntoView({behavior:'smooth'}));
    });
    updateSaveButtons();
  }

  async function loadFacilities(){
    facilities=fallbackFacilities;
    try{
      const res=await fetch('facilities.csv', {cache:'no-store'});
      if(res.ok){
        const parsed=parseCSV(await res.text()).filter(f=>f.prefecture && f.name);
        if(parsed.length) facilities=parsed;
      }
    }catch(e){ /* GitHub Pages以外のローカル表示ではfetchできない場合があります */ }
    populatePrefectures();
    renderFacilities();
  }

  document.querySelectorAll('#conditionGrid input').forEach(input=>{
    input.addEventListener('change',()=>{ updateRecommendations(); renderFacilities(); });
  });
  document.getElementById('prefSelect')?.addEventListener('change',()=>{ populateCities(); renderFacilities(); });
  document.getElementById('citySelect')?.addEventListener('change',renderFacilities);
  document.getElementById('facilitySearch')?.addEventListener('input',renderFacilities);
  document.getElementById('applyFacilityFilter')?.addEventListener('click',renderFacilities);
  document.getElementById('resetFacilityFilter')?.addEventListener('click',()=>{
    document.querySelectorAll('#conditionGrid input').forEach(i=>i.checked=false);
    document.getElementById('prefSelect').value='';
    populateCities();
    document.getElementById('facilitySearch').value='';
    updateRecommendations();
    renderFacilities();
  });
  document.getElementById('copySavedBtn')?.addEventListener('click', async ()=>{
    try{
      await navigator.clipboard.writeText(savedFacilitiesText());
      alert('保存一覧をコピーしました。家族共有や電話確認メモに使えます。');
    }catch(e){
      alert('コピーできませんでした。保存一覧を画面上で確認してください。');
    }
  });
  document.getElementById('printSavedBtn')?.addEventListener('click', ()=>window.print());
  document.getElementById('clearSavedBtn')?.addEventListener('click', ()=>{
    if(confirm('保存した病院・施設をすべて削除しますか？')) setSavedFacilities([]);
  });

  const facilityFinderSection = document.getElementById('facility-finder');
  if(facilityFinderSection && 'IntersectionObserver' in window){
    const observer = new IntersectionObserver(entries=>{
      if(entries.some(e=>e.isIntersecting)){ showCoordinationNotice(); observer.disconnect(); }
    }, {threshold:0.35});
    observer.observe(facilityFinderSection);
  }

  loadFacilities();
  updateRecommendations();
  renderSavedFacilities();




  const shareVersion = 1;
  const shareableTextIds = ["memo1","memo2","memo3","usualStatus","abilityStatus","familySupport"];

  function getShareState(){
    const memos = {};
    shareableTextIds.forEach(id=>{
      const el=document.getElementById(id);
      memos[id]=el ? el.value : (localStorage.getItem("family-navi-"+id)||"");
    });
    const checks = {};
    document.querySelectorAll('[data-check]').forEach(ch=>{ checks[ch.dataset.check]=!!ch.checked; });
    return {
      version: shareVersion,
      updatedAt: new Date().toISOString(),
      memos,
      checks,
      savedFacilities: getSavedFacilities()
    };
  }

  function applyShareState(state){
    if(!state || typeof state !== 'object') return;
    const memos = state.memos || {};
    Object.keys(memos).forEach(id=>{
      const val = String(memos[id] || '');
      const el = document.getElementById(id);
      if(el) el.value = val;
      localStorage.setItem("family-navi-"+id, val);
    });
    const checks = state.checks || {};
    document.querySelectorAll('[data-check]').forEach(ch=>{
      if(Object.prototype.hasOwnProperty.call(checks, ch.dataset.check)){
        ch.checked = !!checks[ch.dataset.check];
        localStorage.setItem('family-navi-check-' + ch.dataset.check, ch.checked);
      }
    });
    if(Array.isArray(state.savedFacilities)){
      localStorage.setItem(savedFacilityKey, JSON.stringify(state.savedFacilities));
      renderSavedFacilities();
      updateSaveButtons();
    }
    updateHospitalSummaryPreview();
  }

  function encodeShareState(state){
    const json = JSON.stringify(state);
    return btoa(unescape(encodeURIComponent(json)));
  }

  function decodeShareState(encoded){
    const json = decodeURIComponent(escape(atob(encoded)));
    return JSON.parse(json);
  }

  function buildShareUrl(){
    const url = new URL(window.location.href);
    url.hash = 'share=' + encodeShareState(getShareState());
    return url.toString();
  }

  function setShareStatus(message, warning=false){
    const box=document.getElementById('shareStatus');
    if(!box) return;
    box.textContent = message;
    box.classList.add('show');
    box.classList.toggle('warn', !!warning);
  }

  function refreshShareUrlBox(){
    const url = buildShareUrl();
    const box=document.getElementById('shareUrlBox');
    if(box) box.value=url;
    const tooLong = url.length > 3500;
    setShareStatus(tooLong ? '共有リンクが長くなっています。保存施設やメモが多い場合、LINEでは送れないことがあります。必要に応じてメモを短くしてください。' : '共有リンクを作成しました。このリンクを開いた家族は内容を編集できます。', tooLong);
    return url;
  }

  async function copyShareUrl(){
    const url = refreshShareUrlBox();
    try{
      await navigator.clipboard.writeText(url);
      setShareStatus('共有リンクをコピーしました。LINEやメールに貼り付けて送れます。');
    }catch(e){
      const box=document.getElementById('shareUrlBox');
      if(box){ box.focus(); box.select(); }
      setShareStatus('自動コピーできませんでした。表示された共有リンクを選択してコピーしてください。', true);
    }
  }

  async function shareToLineLikeApps(){
    const url = refreshShareUrlBox();
    const text = 'もしもの家族ナビの共有メモです。開くと編集できます。編集後は「更新した共有リンクを作る」から再共有してください。';
    if(navigator.share){
      try{ await navigator.share({title:'もしもの家族ナビ 共有メモ', text, url}); return; }
      catch(e){ if(e.name === 'AbortError') return; }
    }
    await copyShareUrl();
    setShareStatus('この端末では共有画面を開けなかったため、共有リンクをコピーしました。LINEなどに貼り付けて送ってください。');
  }

  function tryImportShareFromHash(){
    const hash = window.location.hash || '';
    if(!hash.startsWith('#share=')) return;
    try{
      const encoded = hash.slice('#share='.length);
      const state = decodeShareState(encoded);
      applyShareState(state);
      history.replaceState(null, '', window.location.pathname + window.location.search + '#family-share');
      document.getElementById('shareImportBanner')?.classList.add('show');
      setShareStatus('共有された内容をこの端末に読み込みました。編集したら、更新した共有リンクを作って再共有できます。');
    }catch(e){
      setShareStatus('共有リンクを読み込めませんでした。リンクが途中で切れている可能性があります。', true);
    }
  }

  document.getElementById('makeShareUrlBtn')?.addEventListener('click', refreshShareUrlBox);
  document.getElementById('copyShareUrlBtn')?.addEventListener('click', copyShareUrl);
  document.getElementById('shareToLineBtn')?.addEventListener('click', shareToLineLikeApps);
  document.getElementById('shareImportClose')?.addEventListener('click',()=>document.getElementById('shareImportBanner')?.classList.remove('show'));
  document.getElementById('shareUrlBox')?.addEventListener('focus', e=>e.target.select());
  tryImportShareFromHash();
  refreshShareUrlBox();


  document.querySelectorAll("[data-font]").forEach(btn=>{
    btn.addEventListener("click", ()=>{
      document.documentElement.classList.remove("font-large","font-xlarge");
      if(btn.dataset.font === "large") document.documentElement.classList.add("font-large");
      if(btn.dataset.font === "xlarge") document.documentElement.classList.add("font-xlarge");
    });
  });
  document.getElementById("contrastBtn").addEventListener("click", ()=>document.documentElement.classList.toggle("high-contrast"));
</script>
</body>
